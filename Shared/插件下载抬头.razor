@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<!-- ✅ 顶部导航 -->
<header class="main-header">
    <div class="container">
        <!-- Logo -->
        <a class="logo" href="/">
            <img src="images/海南控股1.png" alt="三鑫全流程BIM应用" class="logo-icon" />
            <span class="logo-text">三鑫全流程BIM应用</span>
        </a>

        <div class="auth-buttons">
            <div class="user-menu" tabindex="0">
                <a id="logoutBtn" class="btn btn-logout">@Username  ↓</a>
                <ul class="menu">
                    <li onclick="location.href='/account/change-password'">
                        <svg class="menu-icon" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
                            <path d="M288 416v-96a128 128 0 0 1 256 0v96h64v-96c0-106-86-192-192-192s-192 86-192 192v96zM512 704h-64v-64l384-384 64 64-384 384z"></path>
                            <path d="M544 736H416V608l160-160H192a64.19 64.19 0 0 0-64 64v320a64.19 64.19 0 0 0 64 64h448a64.19 64.19 0 0 0 64-64V576z"></path>
                        </svg>
                        修改密码</li>
                    <li @onclick="Logout">
                        <svg class="menu-icon" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
                            <path d="M424.19 675.833l64.823 64.823 229.869-229.869-229.869-229.869-64.823 64.823 118.612 119.072H98.236v91.948h444.567L424.19 675.833zM833.817 97.022H190.183c-51.031 0-91.948 41.376-91.948 91.948v183.895h91.948V188.97h643.633v643.633H190.183V648.708H98.236v183.895c0 50.571 40.917 91.948 91.948 91.948h643.633c50.571 0 91.948-41.376 91.948-91.948V188.97c-0.001-50.571-41.377-91.948-91.948-91.948z"></path>
                        </svg>
                        
                        退出登录</li>
                </ul>
            </div>
            <a href="/login" class="btn btn-login" @onclick="Logout">登录</a>
        </div>
    </div>
</header>

@code {
    private string Username = "未登录";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var user = await JS.InvokeAsync<string>("sessionStorage.getItem", "username");
            if (!string.IsNullOrWhiteSpace(user))
            {
                Username = user;
                StateHasChanged(); // 通知刷新
            }
        }
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "username");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}


<main>
    @Body
</main>

<!-- ✅ 页脚 -->
<footer class="main-footer">
    <div class="elementor-divider">
        <span class="elementor-divider-separator"></span>
    </div>
    <div class="footer-container">
        <div class="footer-links">
            <a href="#">法律信息</a>
            <span class="separator">|</span>
            <a href="#">隐私协议</a>
            <span class="separator">|</span>
            <a href="#">用户权限</a>
            <span class="separator">|</span>
            <a href="#">安全信息</a>
            <span class="separator">|</span>
            <a href="#">联系我们</a>
            <span class="separator">|</span>
            <span class="footer-text">应用版本：1.0.0 开发者：三鑫科技</span>
        </div>
        <div class="footer-bottom">
            <p>版权所有©2024 三鑫科技有限公司 保留一切权利。粤ICP备12345678号</p>
        </div>
    </div>
</footer>

<style>
    .elementor-divider {
        display: flex;
        justify-content: center;
        margin: 24px 0;
    }

    .elementor-divider-separator {
        width: 100%;
        max-width: 1000px;
        border-top: 1px solid #ddd;
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', system-ui, sans-serif;
        background: #fff;
        color: #111827;
        z-index:1000;
    }

    .main-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 24px;
        background-color: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        position: fixed; /* 新增 */
        top: 0; /* 新增 */
        left: 0; /* 新增 */
        width: 100%; /* 新增 */
        z-index: 1000; /* 新增：避免被内容遮挡 */
    }

    .container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    .logo-icon {
        width: 140px;
        height: 50px;
        margin-right: 8px;
    }

    .logo-text {
        font-size: 18px;
        color: #333333;
        font-weight: bold;
    }

    .auth-buttons {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    /* 下拉菜单容器 */
    .user-menu {
        position: relative;
        display: inline-block;
        outline: none;
    }

        /* 触发按钮（可选：胶囊样式，和 Fumadocs 接近） */
        .user-menu .btn,
        .user-menu .btn-logout {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 36px;
            padding: 0 14px;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 600;
            color: #111827;
            cursor: pointer;
            transition: box-shadow .15s, border-color .15s, transform .06s;
        }

            .user-menu .btn:hover,
            .user-menu .btn-logout:hover {
                border-color: #d1d5db;
                box-shadow: 0 1px 2px rgba(0,0,0,.04);
            }

        /* 菜单本体：右对齐 + 卡片化 */
        .user-menu .menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0; /* ⭐ 右对齐 */
            left: auto;
            min-width: 120px; /* 稍大一点更稳 */
            margin: 0;
            padding: 8px; /* 从 8px 0 调整为内边距卡片风 */
            list-style: none;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px; /* 更大的圆角 */
            box-shadow: 0 12px 32px rgba(17,24,39,.08), 0 2px 8px rgba(17,24,39,.06); /* 柔和阴影 */
            display: none;
            z-index: 1000;
        }

        /* 悬停或键盘聚焦时显示 */
        .user-menu:hover .menu,
        .user-menu:focus-within .menu {
            display: block;
        }

        /* 菜单项：行高更舒适、圆角悬浮 */
        .user-menu .menu li {
            padding: 10px 10px;
            cursor: pointer;
            white-space: nowrap;
            border-radius: 8px; /* ⭐ 每个 item 也有圆角 */
            font-size: 14px;
            color: #111827;
            transition: background .12s;
            align-items: center; /* 垂直居中 */
        }

        /* 图标大小和颜色继承文字 */
        .user-menu .menu .menu-icon {
            width: 16px;
            height: 16px;
            flex-shrink: 0; /* 防止被压缩变形 */
            display: inline-block;
            vertical-align: middle;
            fill: currentColor; /* 跟随文字颜色变化 */
            padding-right: 8px;

        }

            .user-menu .menu li:hover {
            background: #f3f4f6; /* 比 #f3f4f6 更淡 */
            }

            /* 危险操作（退出登录） */
            .user-menu .menu li.danger {
                color: #b91c1c;
            }

                .user-menu .menu li.danger:hover {
                    background: #fef2f2;
                }

        /* 分割线 */
        .user-menu .menu .sep {
            height: 1px;
            margin: 6px 4px;
            background: #f1f5f9;
            border-radius: 1px;
        }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 90px;
        height: 36px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        border-radius: 20px;
        transition: all 0.3s ease;
        font-family: 'Segoe UI', sans-serif;
        padding: 0 20px;
        box-shadow: 0 0 0 transparent;
    }

    /* 登出按钮（白底黑边） */
    .btn-logout {
        background-color: #ffffff;
        color: #333;
        border: 1.5px solid #333;
    }

        .btn-logout:hover {
            background-color: #f2f2f2;
            transform: scale(1.06);
        }

    /* 登录按钮（浅灰色按钮） */
    .btn-login {
        background-color: #f3f4f6;
        color: #111827;
        border: 1px solid #d1d5db;
    }

        .btn-login:hover {
            background-color: #e5e7eb;
            transform: scale(1.06);
        }

    .main-footer {
        background-color: #ffffff;
        color: #888888;
        font-size: 12px;
        padding: 24px 16px;
        text-align: center;
    }

    .footer-divider {
        border-top: 1px solid #ddd;
        margin: 0 auto 20px;
        width: 100%;
        max-width: 1000px;
    }

    .footer-container {
        max-width: 1000px;
        margin: 0 auto;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .footer-links {
        margin-bottom: 8px;
        line-height: 1.8;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

        .footer-links a,
        .footer-text {
            color: #888;
            font-size: 12px;
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .footer-links a:hover {
                color: #111827;
            }

    .separator {
        margin: 0 4px;
        color: #ccc;
    }

    .footer-bottom {
        color: #aaa;
        text-align: center;
        margin-top: 10px;
        font-size: 12px;
    }

</style>
