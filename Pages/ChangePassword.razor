@page "/account/change-password"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    /* 页面容器：居中 */
    .nd-page {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 48px 16px 80px;
        padding-top: 160px;
    }

    /* 卡片 */
    .cp-card {
        width: 100%;
        max-width: 560px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        padding: 28px;
    }

    /* 标题与描述（Fumadocs风） */
    .cp-title {
        margin: 0 0 6px;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: .2px;
    }

    .cp-desc {
        margin: 0 0 20px;
        color: #6b7280;
        font-size: 14px;
    }

    /* 表单元素 */
    .cp-field {
        margin-bottom: 14px;
    }

        .cp-field label {
            display: block;
            margin-bottom: 6px;
            font-size: 14px;
            color: #374151;
        }

    .cp-input {
        width: 100%;
        box-sizing: border-box; /* 保证 padding 不会撑大 */
        padding: 10px 12px;
        font-size: 14px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        outline: none;
        transition: border-color .15s, box-shadow .15s, background .15s;
        background: #fff;
    }

        .cp-input:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(59,130,246,.15);
        }

    /* 校验摘要（可隐藏或自定） */
    .cp-summary {
        margin-bottom: 8px;
    }

    /* Callout */
    .cp-callout {
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 14px;
        margin: 10px 0 14px;
        border: 1px solid;
    }

        .cp-callout.ok {
            color: #166534;
            background: #ecfdf5;
            border-color: #a7f3d0;
        }

        .cp-callout.error {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

    /* 提交按钮 */
    .cp-btn {
        width: 100%;
        border: 0;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        background: #111827;
        color: #fff;
        box-shadow: 0 6px 16px rgba(17,24,39,.15);
        transition: transform .08s ease, box-shadow .2s ease, opacity .2s;
    }

        .cp-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(17,24,39,.18);
        }

        .cp-btn:disabled {
            opacity: .6;
            cursor: default;
            transform: none;
            box-shadow: none;
        }

    @@media (max-width:640px) {
        .cp-card

    {
        padding: 22px;
        border-radius: 14px;
    }

    }
</style>


<div class="nd-page">
    <div class="cp-card">
        <h1 class="cp-title">修改密码</h1>
        <p class="cp-desc">为保障安全，修改完成后将自动跳转到登录页。</p>

        <EditForm Model="@model" OnValidSubmit="@OnSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="cp-summary" />

            <div class="cp-field">
                <label>用户名</label>
                <InputText class="cp-input" @bind-Value="model.Username" />
                <ValidationMessage For="@(() => model.Username)" />
            </div>

            <div class="cp-field">
                <label>原密码</label>
                <InputText class="cp-input" type="password" @bind-Value="model.OldPassword" />
                <ValidationMessage For="@(() => model.OldPassword)" />
            </div>

            <div class="cp-field">
                <label>新密码</label>
                <InputText class="cp-input" type="password" @bind-Value="model.NewPassword" />
                <ValidationMessage For="@(() => model.NewPassword)" />
            </div>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="cp-callout error">@error</div>
            }
            @if (!string.IsNullOrWhiteSpace(success))
            {
                <div class="cp-callout ok">@success</div>
            }

            <button class="cp-btn" type="submit" disabled="@submitting">
                @(submitting ? "提交中..." : "确认修改")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private ChangePasswordModel model = new();
    private bool submitting;
    private string? error;
    private string? success;

    protected override async Task OnInitializedAsync()
    {
        // 从 sessionStorage 取用户名，减少输入
        try
        {
            var name = await JS.InvokeAsync<string>("sessionStorage.getItem", "username");
            if (!string.IsNullOrWhiteSpace(name)) model.Username = name!;
        }
        catch { }
    }

    private async Task OnSubmit()
    {
        error = success = null;
        submitting = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/auth/change-password", new
            {
                username = model.Username,
                oldPassword = model.OldPassword,
                newPassword = model.NewPassword
            });
            var data = await res.Content.ReadFromJsonAsync<ApiResult>();
            if (res.IsSuccessStatusCode && (data?.success ?? false))
            {
                success = "修改成功，正在跳转登录页…";
                await Task.Delay(800);
                Nav.NavigateTo("/login", true);
            }
            else error = data?.message ?? "修改失败，请检查输入。";
        }
        catch { error = "请求失败，请稍后重试。"; }
        finally { submitting = false; }
    }

    private class ApiResult { public bool success { get; set; } public string? message { get; set; } }
    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "请输入用户名")] public string Username { get; set; } = string.Empty;
        [Required(ErrorMessage = "请输入原密码")] public string OldPassword { get; set; } = string.Empty;
        [Required(ErrorMessage = "请输入新密码"), MinLength(3, ErrorMessage = "新密码至少 3 位")]
        public string NewPassword { get; set; } = string.Empty;
    }
}
