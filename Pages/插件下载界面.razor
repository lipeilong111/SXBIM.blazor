                <span class="changelog-badge" tabindex="0">更新日志</span>
                <div class="changelog-popover">
                    @foreach (var release in snailLog.Releases)
                    {
                        <div class="changelog-title">@($"---V{release.Version}---")</div>
                        <ul class="changelog-list">
                            @foreach (var note in release.Notes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }


        <h3>
            <span class="badge">2</span>SX_Snail
        </h3>
        <p>一款基于 Rhino & Grasshopper 的智能建模插件，实现加工图自动生成、构件自动编号、材料清单提取，让设计与制造高效衔接</p>
        <div class="spacer"></div>
        <p class="platform">
            <strong>支持平台：</strong>Rhino 7.4+ / Grasshopper
            <br />
            <strong>当前版本：</strong>@($"V{rhinoVersion}")
            <br />
            <strong>更新日期：</strong>@rhinoUpdateDate
        </p>
        <p>
        </p>
        <div class="button-group">
            <button @onclick="GoToDocsRHINO">文档</button>
            <button @onclick="DownloadMultiple">下载</button>
        </div>
    </div>

    <div class="card">
        @if (_updateLog != null && _updateLog.TryGetValue("sxrevit", out var revitLog) && revitLog.Releases?.Count > 0)
        {
