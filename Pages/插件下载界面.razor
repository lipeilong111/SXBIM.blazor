                    {
                        <div class="changelog-title">@($"---V{release.Version}---")</div>
                        <ul class="changelog-list">
                            @foreach (var note in release.Notes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }


        <h3>
            <span class="badge">1</span>
            SX_Cad
        </h3>
        <p>一款基于 CAD 的智能设计插件，实现 CAD 与 Rhino 模型及信息的高效互通，快速出图，提升团队协同效率</p>
